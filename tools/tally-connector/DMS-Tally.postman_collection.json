{
    "info": {
        "name": "DMS <-> Tally connector tests",
        "description": "Run top to bottom. Steps 3 and 4 WRITE into the Tally company named in {{tallyCompany}} — use a test company, or delete the test entries in Tally afterwards (they carry the narration \"DMS ...\").\n\nOrder for a voucher: uom -> customer -> product -> voucher. Tally rejects a voucher whose ledger / stock item / unit / godown does not exist yet.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "dmsUrl",
            "value": "http://127.0.0.1:8000"
        },
        {
            "key": "token",
            "value": "PASTE_TALLY_CONNECTOR_TOKEN"
        },
        {
            "key": "tallyUrl",
            "value": "http://127.0.0.1:9000"
        },
        {
            "key": "tallyCompany",
            "value": "DMS TEST"
        },
        {
            "key": "type",
            "value": "invoice"
        },
        {
            "key": "id",
            "value": "18"
        },
        {
            "key": "tallyXml",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "1. Read-only checks",
            "item": [
                {
                    "name": "DMS health",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('DMS reachable + token OK', () => pm.expect(pm.response.json().ok).to.eql(true));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "description": "Checks the token and that the server runs in connector mode.",
                        "header": [
                            {
                                "key": "X-Tally-Connector-Token",
                                "value": "{{token}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{dmsUrl}}/api/tally-connector/health",
                            "host": [
                                "{{dmsUrl}}"
                            ],
                            "path": [
                                "api",
                                "tally-connector",
                                "health"
                            ]
                        }
                    }
                },
                {
                    "name": "Tally: companies open",
                    "event": [],
                    "request": {
                        "method": "POST",
                        "description": "Lists companies currently loaded in Tally. {{tallyCompany}} must be one of them.",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "text/xml; charset=utf-8"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "<ENVELOPE>\n <HEADER>\n  <VERSION>1</VERSION>\n  <TALLYREQUEST>Export</TALLYREQUEST>\n  <TYPE>Collection</TYPE>\n  <ID>DmsList</ID>\n </HEADER>\n <BODY>\n  <DESC>\n   <STATICVARIABLES>\n    <SVCURRENTCOMPANY>{{tallyCompany}}</SVCURRENTCOMPANY>\n    <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>\n   </STATICVARIABLES>\n   <TDL>\n    <TDLMESSAGE>\n     <COLLECTION NAME=\"DmsList\">\n      <TYPE>Company</TYPE>\n      <FETCH>Name</FETCH>\n     </COLLECTION>\n    </TDLMESSAGE>\n   </TDL>\n  </DESC>\n </BODY>\n</ENVELOPE>",
                            "options": {
                                "raw": {
                                    "language": "xml"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{tallyUrl}}",
                            "host": [
                                "{{tallyUrl}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Tally: godowns",
                    "event": [],
                    "request": {
                        "method": "POST",
                        "description": "Every DMS warehouse used on a voucher must exist here (DMS now creates it first).",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "text/xml; charset=utf-8"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "<ENVELOPE>\n <HEADER>\n  <VERSION>1</VERSION>\n  <TALLYREQUEST>Export</TALLYREQUEST>\n  <TYPE>Collection</TYPE>\n  <ID>DmsList</ID>\n </HEADER>\n <BODY>\n  <DESC>\n   <STATICVARIABLES>\n    <SVCURRENTCOMPANY>{{tallyCompany}}</SVCURRENTCOMPANY>\n    <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>\n   </STATICVARIABLES>\n   <TDL>\n    <TDLMESSAGE>\n     <COLLECTION NAME=\"DmsList\">\n      <TYPE>Godown</TYPE>\n      <FETCH>Name,Parent</FETCH>\n     </COLLECTION>\n    </TDLMESSAGE>\n   </TDL>\n  </DESC>\n </BODY>\n</ENVELOPE>",
                            "options": {
                                "raw": {
                                    "language": "xml"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{tallyUrl}}",
                            "host": [
                                "{{tallyUrl}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Tally: units",
                    "event": [],
                    "request": {
                        "method": "POST",
                        "description": "Units used on DMS lines must exist here.",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "text/xml; charset=utf-8"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "<ENVELOPE>\n <HEADER>\n  <VERSION>1</VERSION>\n  <TALLYREQUEST>Export</TALLYREQUEST>\n  <TYPE>Collection</TYPE>\n  <ID>DmsList</ID>\n </HEADER>\n <BODY>\n  <DESC>\n   <STATICVARIABLES>\n    <SVCURRENTCOMPANY>{{tallyCompany}}</SVCURRENTCOMPANY>\n    <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>\n   </STATICVARIABLES>\n   <TDL>\n    <TDLMESSAGE>\n     <COLLECTION NAME=\"DmsList\">\n      <TYPE>Unit</TYPE>\n      <FETCH>Name</FETCH>\n     </COLLECTION>\n    </TDLMESSAGE>\n   </TDL>\n  </DESC>\n </BODY>\n</ENVELOPE>",
                            "options": {
                                "raw": {
                                    "language": "xml"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{tallyUrl}}",
                            "host": [
                                "{{tallyUrl}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Tally: ledgers",
                    "event": [],
                    "request": {
                        "method": "POST",
                        "description": "Check the TALLY_*_LEDGER names from .env exist.",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "text/xml; charset=utf-8"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "<ENVELOPE>\n <HEADER>\n  <VERSION>1</VERSION>\n  <TALLYREQUEST>Export</TALLYREQUEST>\n  <TYPE>Collection</TYPE>\n  <ID>DmsList</ID>\n </HEADER>\n <BODY>\n  <DESC>\n   <STATICVARIABLES>\n    <SVCURRENTCOMPANY>{{tallyCompany}}</SVCURRENTCOMPANY>\n    <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>\n   </STATICVARIABLES>\n   <TDL>\n    <TDLMESSAGE>\n     <COLLECTION NAME=\"DmsList\">\n      <TYPE>Ledger</TYPE>\n      <FETCH>Name,Parent</FETCH>\n     </COLLECTION>\n    </TDLMESSAGE>\n   </TDL>\n  </DESC>\n </BODY>\n</ENVELOPE>",
                            "options": {
                                "raw": {
                                    "language": "xml"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{tallyUrl}}",
                            "host": [
                                "{{tallyUrl}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Test company setup (ONLY in a test company)",
            "item": [
                {
                    "name": "Create accounting ledgers used by DMS",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.text();",
                                    "const count = (tag) => { const m = body.match(new RegExp('<' + tag + '>\\\\s*(-?\\\\d+)', 'i')); return m ? Number(m[1]) : 0; };",
                                    "const decode = (s) => s.replace(/&apos;/g, \"'\").replace(/&quot;/g, '\"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');",
                                    "const lineErrors = [...body.matchAll(/<LINEERROR>([\\s\\S]*?)<\\/LINEERROR>/gi)].map((m) => decode(m[1].trim()));",
                                    "const summary = `CREATED=${count('CREATED')} ALTERED=${count('ALTERED')} ERRORS=${count('ERRORS')} EXCEPTIONS=${count('EXCEPTIONS')} LASTVCHID=${count('LASTVCHID')}`;",
                                    "console.log(summary, lineErrors);",
                                    "pm.test('No Tally line errors ' + (lineErrors.length ? '-> ' + lineErrors.join(' | ') : ''), () => pm.expect(lineErrors).to.be.empty);",
                                    "pm.test('No ERRORS / EXCEPTIONS (' + summary + ')', () => pm.expect(count('ERRORS') + count('EXCEPTIONS')).to.eql(0));",
                                    "pm.test('Something was created or altered', () => pm.expect(count('CREATED') + count('ALTERED') + count('COMBINED')).to.be.above(0));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "description": "Creates the purchase/sales/GST/round-off/bank ledgers the DMS vouchers reference. Only run this in a fresh test company.",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "text/xml; charset=utf-8"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "<ENVELOPE>\n <HEADER><TALLYREQUEST>Import Data</TALLYREQUEST></HEADER>\n <BODY>\n  <IMPORTDATA>\n   <REQUESTDESC>\n    <REPORTNAME>All Masters</REPORTNAME>\n    <STATICVARIABLES><SVCURRENTCOMPANY>{{tallyCompany}}</SVCURRENTCOMPANY></STATICVARIABLES>\n   </REQUESTDESC>\n   <REQUESTDATA>\n    <TALLYMESSAGE xmlns:UDF=\"TallyUDF\">\n     <LEDGER NAME=\"PURCHASE GST INSIDE PUNJAB\" ACTION=\"Create\"><NAME>PURCHASE GST INSIDE PUNJAB</NAME><PARENT>Purchase Accounts</PARENT></LEDGER>\n     <LEDGER NAME=\"PURCHASE GST OUSTIDE PUNJAB\" ACTION=\"Create\"><NAME>PURCHASE GST OUSTIDE PUNJAB</NAME><PARENT>Purchase Accounts</PARENT></LEDGER>\n     <LEDGER NAME=\"SALE GST IN PUNJAB\" ACTION=\"Create\"><NAME>SALE GST IN PUNJAB</NAME><PARENT>Sales Accounts</PARENT></LEDGER>\n     <LEDGER NAME=\"CGST\" ACTION=\"Create\"><NAME>CGST</NAME><PARENT>Duties &amp; Taxes</PARENT></LEDGER>\n     <LEDGER NAME=\"SGST\" ACTION=\"Create\"><NAME>SGST</NAME><PARENT>Duties &amp; Taxes</PARENT></LEDGER>\n     <LEDGER NAME=\"IGST\" ACTION=\"Create\"><NAME>IGST</NAME><PARENT>Duties &amp; Taxes</PARENT></LEDGER>\n     <LEDGER NAME=\"ROUND OFF\" ACTION=\"Create\"><NAME>ROUND OFF</NAME><PARENT>Indirect Expenses</PARENT></LEDGER>\n     <LEDGER NAME=\"HDFC BANK 50200088458819\" ACTION=\"Create\"><NAME>HDFC BANK 50200088458819</NAME><PARENT>Bank Accounts</PARENT></LEDGER>\n    </TALLYMESSAGE>\n   </REQUESTDATA>\n  </IMPORTDATA>\n </BODY>\n</ENVELOPE>",
                            "options": {
                                "raw": {
                                    "language": "xml"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{tallyUrl}}",
                            "host": [
                                "{{tallyUrl}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. DMS -> Tally (preview then send)",
            "item": [
                {
                    "name": "List DMS records of {{type}}",
                    "event": [],
                    "request": {
                        "method": "GET",
                        "description": "Types: invoice, payment, credit_note, purchase_invoice, purchase_order, product, customer, uom, godown. Pick an id and set the {{id}} variable.",
                        "header": [
                            {
                                "key": "X-Tally-Connector-Token",
                                "value": "{{token}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{dmsUrl}}/api/tally-connector/preview/{{type}}",
                            "host": [
                                "{{dmsUrl}}"
                            ],
                            "path": [
                                "api",
                                "tally-connector",
                                "preview",
                                "{{type}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Preview XML for {{type}} #{{id}}",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('DMS returned XML', () => pm.expect(pm.response.code).to.eql(200));",
                                    "let xml = pm.response.text();",
                                    "const company = pm.collectionVariables.get('tallyCompany');",
                                    "if (company) {",
                                    "  const esc = company.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');",
                                    "  xml = xml.replace(/<SVCURRENTCOMPANY>[\\s\\S]*?<\\/SVCURRENTCOMPANY>/i, '<SVCURRENTCOMPANY>' + esc + '</SVCURRENTCOMPANY>');",
                                    "}",
                                    "pm.collectionVariables.set('tallyXml', xml);",
                                    "console.log('Saved to {{tallyXml}} — now run \"Send saved XML to Tally\"');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "description": "Builds the XML exactly as the connector would send it (not queued). Saves it into {{tallyXml}} with {{tallyCompany}} swapped in.",
                        "header": [
                            {
                                "key": "X-Tally-Connector-Token",
                                "value": "{{token}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{dmsUrl}}/api/tally-connector/preview/{{type}}/{{id}}",
                            "host": [
                                "{{dmsUrl}}"
                            ],
                            "path": [
                                "api",
                                "tally-connector",
                                "preview",
                                "{{type}}",
                                "{{id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Send saved XML to Tally",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.text();",
                                    "const count = (tag) => { const m = body.match(new RegExp('<' + tag + '>\\\\s*(-?\\\\d+)', 'i')); return m ? Number(m[1]) : 0; };",
                                    "const decode = (s) => s.replace(/&apos;/g, \"'\").replace(/&quot;/g, '\"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');",
                                    "const lineErrors = [...body.matchAll(/<LINEERROR>([\\s\\S]*?)<\\/LINEERROR>/gi)].map((m) => decode(m[1].trim()));",
                                    "const summary = `CREATED=${count('CREATED')} ALTERED=${count('ALTERED')} ERRORS=${count('ERRORS')} EXCEPTIONS=${count('EXCEPTIONS')} LASTVCHID=${count('LASTVCHID')}`;",
                                    "console.log(summary, lineErrors);",
                                    "pm.test('No Tally line errors ' + (lineErrors.length ? '-> ' + lineErrors.join(' | ') : ''), () => pm.expect(lineErrors).to.be.empty);",
                                    "pm.test('No ERRORS / EXCEPTIONS (' + summary + ')', () => pm.expect(count('ERRORS') + count('EXCEPTIONS')).to.eql(0));",
                                    "pm.test('Something was created or altered', () => pm.expect(count('CREATED') + count('ALTERED') + count('COMBINED')).to.be.above(0));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "description": "Posts {{tallyXml}} to Tally and checks the CREATED / ERRORS / EXCEPTIONS counters.",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "text/xml; charset=utf-8"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{{tallyXml}}",
                            "options": {
                                "raw": {
                                    "language": "xml"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{tallyUrl}}",
                            "host": [
                                "{{tallyUrl}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "4. Connector queue (what connector.mjs does)",
            "item": [
                {
                    "name": "Pending queue items",
                    "event": [],
                    "request": {
                        "method": "GET",
                        "description": "The XML the connector will pick up next, in id order.",
                        "header": [
                            {
                                "key": "X-Tally-Connector-Token",
                                "value": "{{token}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{dmsUrl}}/api/tally-connector/pending?limit=10",
                            "host": [
                                "{{dmsUrl}}"
                            ],
                            "path": [
                                "api",
                                "tally-connector",
                                "pending?limit=10"
                            ]
                        }
                    }
                },
                {
                    "name": "Report result for queue item",
                    "request": {
                        "method": "POST",
                        "description": "Marks a queue row sent/failed, like the connector does after posting to Tally. Replace 1 with the queue id.",
                        "header": [
                            {
                                "key": "X-Tally-Connector-Token",
                                "value": "{{token}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"sent\",\n  \"response\": \"<RESPONSE><CREATED>1</CREATED><LASTVCHID>0</LASTVCHID></RESPONSE>\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{dmsUrl}}/api/tally-connector/1/result",
                            "host": [
                                "{{dmsUrl}}"
                            ],
                            "path": [
                                "api",
                                "tally-connector",
                                "1",
                                "result"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}